# Your backend HTTP port. Ex: 3001
PORT=

# Your frontend URL. Ex: http://localhost:3000
SITE_URL=

# The MongoDB connection string. Ex: mongodb://localhost:27017/cerberus
DATABASE_URL=

# The frontend URL for CORS. Ex: http://localhost:3000 or *
CORS_ORIGIN=

# The JWT secret key for signing tokens. Ex: mysecret
JWT_SECRET=

# The JWT expiration time in seconds. Ex: 3600 for 1 hour
JWT_EXPIRES=

# The blockchain network ID. Ex: 1 for Ethereum mainnet, 56 for Binance Smart Chain, etc.
CHAIN_ID=

# The auth message to be signed in every login. Ex: "Authentication to cerberus timesTamp <timestamp>"
AUTH_MSG=

# The Cerberus pay contract address. Ex: 0x1234567890abcdef1234567890abcdef12345678
CERBERUS_PAY_CONTRACT=

# The mailer transport string Ex: smtp://user@domain.com:password@smtp.domain.com
MAILER_TRANSPORT=

# Your blockchain RPC node URL. Ex: https://mainnet.infura.io/v3/YOUR-PROJECT-ID
RPC_NODE=

# The private key of the admin wallet. Ex: 0x
ADMIN_PRIVATE_KEY=

#   The AES key for encrypting sensitive data. Ex: 32-byte hex string
AES_KEY=

# The Uniswap V3 router contract address. Ex: 0x1095692A4181938501062f8373b9e4aB8d7fDCEE Universal Router (Etherium). See all at https://docs.uniswap.org/contracts/v3/reference/deployments
UNISWAP_ROUTER=