# This is an example environment configuration file for the Cerberus engine.
INTERVAL=

# The interval in milliseconds at which the engine will poll for new data.
NETWORK=

# The network to connect to (e.g., mainnet, ropsten, etc.).
EXCHANGE=uniswapv3

# The URL of the database to connect to. This should be in the format of a connection string.
DATABASE_URL=

# The URL of the Uniswap GraphQL subgraph.
UNISWAP_GRAPH_URL=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3

# The number of pools to fetch from the Uniswap subgraph. This can be adjusted based on the needs of the application.
POOL_COUNT=2000

# The interval time in ms to chage payments. Ex: 3600000 (60min)
CHARGE_INTERVAL=

# the 32 alphanumeric characters AES key
AES_KEY=

# The Uniswap V3 router contract address. Ex: 0x1095692A4181938501062f8373b9e4aB8d7fDCEE Universal Router (Etherium). See all at https://docs.uniswap.org/contracts/v3/reference/deployments
UNISWAP_ROUTER=

# The frontend URL for CORS. Ex: http://localhost:3000 or *
CORS_ORIGIN=